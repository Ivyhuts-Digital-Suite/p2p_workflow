NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/p2p

# Optional: where "npm run db" keeps its data (default: ~/.p2p-workflow/mongo-data).
# Keep it out of OneDrive, Dropbox and similar: a sync client locking a file can crash MongoDB.
# LOCAL_MONGO_DBPATH=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173

# Buyer (our company) GSTIN - its first two digits decide intra- vs inter-state GST
COMPANY_GSTIN=27AABCU9603R1ZM

# Allowed unit-price variance (%) between PO and invoice during 3-way match
MATCH_PRICE_TOLERANCE_PCT=2

# Stock expiring within this many days appears on the near-expiry report
NEAR_EXPIRY_DAYS=90

# Largest pre-tax value of a PO raised through the emergency route, without an RFQ
EMERGENCY_PO_CAP=100000

# Bank or payment gateway (see "Bank integration" in the README). With no URL, payments are
# simulated outside production and refused in production. The webhook is refused without a secret.
BANK_API_URL=
BANK_API_KEY=
BANK_WEBHOOK_SECRET=
BANK_TIMEOUT_MS=15000

# Code required for internal-role self sign-up. With NODE_ENV=production and no code set,
# internal self sign-up is switched off. Leave blank in development.
INTERNAL_SIGNUP_CODE=
