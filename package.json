{
  "name": "p2p-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Procure-to-Pay platform",
  "scripts": {
    "dev": "concurrently -n db,api,web -c yellow,blue,green \"npm run db\" \"npm run dev:api\" \"npm run dev:web\"",
    "db": "cd backend && tsx scripts/local-mongo.ts",
    "dev:api": "cd backend && tsx watch src/server.ts",
    "dev:web": "vite frontend",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p backend",
    "build:web": "tsc -p frontend && vite build frontend",
    "start": "cd backend && node dist/server.js",
    "seed": "cd backend && tsx src/seed/seed.ts",
    "typecheck": "tsc -p backend --noEmit && tsc -p frontend && tsc -p tsconfig.json",
    "test:e2e": "cd backend && tsx scripts/e2e.ts"
  },
  "dependencies": {
    "axios": "1.7.9",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "morgan": "1.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "mongodb-memory-server": "10.1.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
